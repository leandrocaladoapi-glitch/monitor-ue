# Production: PostgreSQL private database. Never commit real values.
# Sem DATABASE_URL o site continua recebendo contatos por e-mail (modo notificação direta);
# com DATABASE_URL ativo, cada lead também fica registrado no banco privado.
DATABASE_URL=
# Chave usada no rate limit persistente. Sem ela, o limite vale apenas por instância ativa.
RATE_LIMIT_SECRET=
SITE_URL=https://monitor.lcfconsulting.com.br

# ---- Aviso de novos contatos (leads) para o e-mail da equipe ----
# Um ou mais endereços separados por vírgula. Sem isto nenhum e-mail é enviado.
LEAD_NOTIFY_EMAIL=
# Resend (HTTPS; recomendado na Vercel). Criar a chave em https://resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM=LCF Consulting <onboarding@resend.dev>
# FORMSUBMIT (sem DNS/domínio próprio). Criar a chave em https://formsubmit.co.
FORMSUBMIT_KEY=
# SMTP exige STARTTLS (587) ou TLS implícito (465). A Vercel bloqueia a porta 25.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Força um transporte: resend | formsubmit | smtp. Por padrão usa o primeiro configurado.
LEAD_EMAIL_PROVIDER=

# Local development only. SQLite is rejected on Vercel even if MONITOR_DEV=1.
# MONITOR_DEV=1
# COMMERCIAL_SQLITE=/tmp/monitor-commercial.sqlite3
